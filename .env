# Gemini API 키 (필수)
GEMINI_API_KEY=AIzaSyAzcY6LwJBT9-JQCcYjD2n6jbZYKpVedVU

# 파일 업로드 제한 (MB)
MAX_UPLOAD_SIZE_MB=512

# Gemini CLI model.  ``auto`` 면 ``--model`` 인자 자체를 빼서 CLI 의
# 자동 라우팅(Auto Gemini 3 — task 복잡도에 따라 pro/flash 선택 + 쿼터
# 소진 시 폴백) 에 맡기고, 구체 모델명을 주면 그 모델로 고정한다.
#   - gemini-3-pro-preview    : Gemini 3 Pro (품질 우선, 쿼터 적음)
#   - gemini-3-flash-preview  : Gemini 3 Flash (쿼터 넉넉, 속도 우선)
#   - gemini-2.5-pro / gemini-2.5-flash
#   - auto / default          : CLI 자동 라우팅
GEMINI_MODEL=gemini-3-pro-preview
GEMINI_MODELS=gemini-3-pro-preview
VEX_GEMINI_CLI_MODE=interactive
# rate-limit 재시도 횟수 (각 사이클마다 쿼터 회복 대기).  6 이면 최대 6회 재시도.
VEX_GEMINI_MODEL_RETRY_CYCLES=6
# 에러 메시지에서 retry 시간을 파싱 못 했을 때 기본 대기 (초, 기본 1시간).
VEX_GEMINI_RATE_LIMIT_DEFAULT_WAIT=3600
# retry 시간 상한 (초, 기본 1시간) — 너무 긴 대기를 방지.
VEX_GEMINI_RATE_LIMIT_MAX_WAIT=3600
