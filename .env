# Gemini API 키 (필수)
GEMINI_API_KEY=AIzaSyAzcY6LwJBT9-JQCcYjD2n6jbZYKpVedVU

# 파일 업로드 제한 (MB)
MAX_UPLOAD_SIZE_MB=512

# Gemini CLI model — auto 모드.  CLI 가 기본 모델(Pro)을 쓰다가 쿼터에 걸리면
# Flash 계열로 자동 폴백하도록 `--model` 플래그를 생략한다.
# (vex.py 에서 auto/default 값은 `--model` 인자 자체를 빼도록 처리)
GEMINI_MODEL=auto
GEMINI_MODELS=auto
VEX_GEMINI_CLI_MODE=interactive
# rate-limit 재시도 횟수 (각 사이클마다 쿼터 회복 대기).  6 이면 최대 6회 재시도.
VEX_GEMINI_MODEL_RETRY_CYCLES=6
# 에러 메시지에서 retry 시간을 파싱 못 했을 때 기본 대기 (초, 기본 1시간).
VEX_GEMINI_RATE_LIMIT_DEFAULT_WAIT=3600
# retry 시간 상한 (초, 기본 1시간) — 너무 긴 대기를 방지.
VEX_GEMINI_RATE_LIMIT_MAX_WAIT=3600
